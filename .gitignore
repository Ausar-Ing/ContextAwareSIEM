# Windows "mark of the web" metadata streams, not real content
*:Zone.Identifier

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Wazuh install artifacts and secrets - never commit these
wazuh-install-files.tar
wazuh-install-files/
*wazuh-passwords*

# Local logs and scratch
*.log

# LaTeX build artifacts (keep the compiled figure PDFs)
*.aux
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls

# Sample Wazuh alert export used for log analysis, not a project artifact
wazuh_dataset.json

# python
__pycache__/
*.pyc

# Baseline corpus and rotated alert logs - PERSONAL DATA from a daily-driver
# machine. Never commit: the repository is submitted, the corpus is not.
# See baseline_collection_protocol.md section 5.
baseline_corpus*.json
baseline_corpus*.json.gz
*.json.gz
alerts*.json

# Environment provenance snapshots may contain hostnames / usernames.
# Commit the REDACTED copy only (provenance/redacted/).
provenance/raw/

# editor/script backups
*.bak

# Wazuh installer credentials live in WSL ~/wazuh-setup, never in this repo
Pass.txt
wazuh-passwords.txt

# Public datasets (large, licensed separately; download from source, never commit)
data/

# keep the run logs of the locked test run and its dry run (2026-10-31)
!provenance/ait/test/*.out
!provenance/ait/dryrun/*.out
!provenance/ait/test_crash*/*.out

# local planning file, not pushed (2026-10-31)
SCHEDULE.md

# evaluation caches written to the working directory (~100 MB each), 2026-10-31
*.pkl

# example deliverables from the course, kept locally for reference, not part of the submission (2026-11-01)
References/Deliverable3_Example*.pdf
!provenance/ait/rerun_self/*.out

# review and audit reports from helpers: kept locally, not on main (2026-11-03)
docs/Code_review_report/
docs/Locked_run_report/
Claude outputs/
